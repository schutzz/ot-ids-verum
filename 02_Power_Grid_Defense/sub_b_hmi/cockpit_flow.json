    {
        "id": "func_update_state",
        "type": "function",
        "z": "tab_cockpit",
        "name": "Save Grid State to Global",
        "func": "let st = msg.payload.state;\nlet soc = msg.payload.soc !== undefined ? msg.payload.soc : (st ? 100.0 : 65.0);\nlet cb_states = msg.payload.cb_states || { CB101: st, CB102: st, CB103: st, CB104: st };\nglobal.set('is_tripped', !st);\nglobal.set('cb_states', cb_states);\nglobal.set('ups_soc', soc);\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 180,
        "wires": [
            [
                "func_zipkin_span"
            ]
        ]
    },
    {
        "id": "func_zipkin_span",
        "type": "function",
        "z": "tab_cockpit",
        "name": "Build OTLP Metric (breaker_open_count)",
        "func": "var isTripped = (msg.payload.state === false);\nif (!isTripped) { return null; }\nvar now = Date.now();\nvar nowNano = (now * 1000000).toString();\nmsg.payload = {\n    \"resourceMetrics\": [{\n        \"resource\": {\n            \"attributes\": [\n                {\"key\": \"service.name\", \"value\": {\"stringValue\": \"hmi-nodered\"}},\n                {\"key\": \"deployment.environment\", \"value\": {\"stringValue\": \"ot-lab\"}}\n            ]\n        },\n        \"scopeMetrics\": [{\n            \"metrics\": [{\n                \"name\": \"breaker_open_count\",\n                \"sum\": {\n                    \"dataPoints\": [{\n                        \"attributes\": [\n                            {\"key\": \"grid\", \"value\": {\"stringValue\": \"Kyiv-North-330kV\"}},\n                            {\"key\": \"event_type\", \"value\": {\"stringValue\": \"BREAKER_OPEN\"}},\n                            {\"key\": \"service.name\", \"value\": {\"stringValue\": \"hmi-nodered\"}}\n                        ],\n                        \"startTimeUnixNano\": nowNano,\n                        \"timeUnixNano\": nowNano,\n                        \"asInt\": \"1\"\n                    }],\n                    \"aggregationTemporality\": 2,\n                    \"isMonotonic\": true\n                }\n            }]\n        }]\n    }]\n};\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
