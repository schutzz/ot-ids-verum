    {
        "id": "func_breaker_gauge",
        "type": "function",
        "z": "tab_cockpit",
        "name": "Build breaker_status gauge (0/1)",
        "func": "var isTripped = global.get('is_tripped') || false;\nvar val = isTripped ? 1 : 0;\nvar now = Date.now();\nvar nowNano = (now * 1000000).toString();\n\n// 攻撃時はランダムなエフェメラalポート（49152〜65535）を動的生成して乱立を再現\nvar randomPort = isTripped ? (Math.floor(Math.random() * (65535 - 49152 + 1)) + 49152).toString() : \"49152\";\n\nvar metrics = [\n  {\n    \"name\": \"breaker_status\",\n    \"gauge\": {\n      \"dataPoints\": [{\n        \"attributes\": [\n          {\"key\": \"grid\", \"value\": {\"stringValue\": \"Kyiv-North-330kV\"}},\n          {\"key\": \"service.name\", \"value\": {\"stringValue\": \"hmi-nodered\"}}\n        ],\n        \"timeUnixNano\": nowNano,\n        \"asInt\": val.toString()\n      }]\n    }\n  },\n  {\n    \"name\": \"correlation_timeout\",\n    \"gauge\": {\n      \"dataPoints\": [{\n        \"attributes\": [\n          {\"key\": \"grid\", \"value\": {\"stringValue\": \"Kyiv-North-330kV\"}},\n          {\"key\": \"service.name\", \"value\": {\"stringValue\": \"hmi-nodered\"}},\n          {\"key\": \"attack_stage\", \"value\": {\"stringValue\": isTripped ? \"POST_ATTACK\" : \"NORMAL\"}}\n        ],\n        \"timeUnixNano\": nowNano,\n        \"asInt\": val.toString()\n      }]\n    }\n  },\n  {\n    \"name\": \"network.connection_attempt\",\n    \"gauge\": {\n      \"dataPoints\": [{\n        \"attributes\": [\n          {\"key\": \"src_ip\", \"value\": {\"stringValue\": \"192.168.10.100\"}},\n          {\"key\": \"dest_port\", \"value\": {\"stringValue\": \"20000\"}},\n          {\"key\": \"src_port\", \"value\": {\"stringValue\": randomPort}},\n          {\"key\": \"service.name\", \"value\": {\"stringValue\": \"hmi-nodered\"}}\n        ],\n        \"timeUnixNano\": nowNano,\n        \"asInt\": \"1\"\n      }]\n    }\n  }\n];\n\nmsg.payload = {\n  \"resourceMetrics\": [{\n    \"resource\": {\n      \"attributes\": [\n        {\"key\": \"service.name\", \"value\": {\"stringValue\": \"hmi-nodered\"}},\n        {\"key\": \"deployment.environment\", \"value\": {\"stringValue\": \"ot-lab\"}}\n      ]\n    },\n    \"scopeMetrics\": [{\"metrics\": metrics}]\n  }]\n};\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
