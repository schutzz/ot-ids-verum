    {
        "id": "template_cockpit_html",
        "type": "template",
        "z": "tab_cockpit",
        "name": "Cockpit HTML Page",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"UTF-8\">\n<title>広域電力網 (Kyiv-Grid) 統合リアルタイム監視コックピット</title>\n<style>\n  body { margin: 0; background: #0f172a; color: #f8fafc; font-family: 'Segoe UI', sans-serif; overflow: hidden; }\n  header { background: #1e293b; padding: 15px 25px; border-bottom: 2px solid #3b82f6; display: flex; justify-content: space-between; align-items: center; }\n  h1 { margin: 0; font-size: 19px; font-weight: 600; color: #60a5fa; }\n  .badge { background: #166534; color: #4ade80; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; }\n  .badge.alert { background: #991b1b; color: #fca5a5; animation: pulse 0.8s infinite alternate; }\n  .container { display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; padding: 20px; box-sizing: border-box; height: calc(100vh - 70px); }\n  .panel { background: #1e293b; border-radius: 10px; border: 1px solid #334155; padding: 20px; display: flex; flex-direction: column; height: 100%; box-sizing: border-box; overflow: hidden; shadow: 0 4px 6px rgba(0,0,0,0.3); }\n  .panel-title { font-size: 15px; font-weight: bold; color: #94a3b8; border-bottom: 1px solid #334155; padding-bottom: 10px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }\n  \n  .sub-section-title { font-size: 12px; font-weight: bold; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px; margin: 8px 0 6px 0; border-left: 3px solid #0284c7; padding-left: 6px; }\n  \n  /* 遮断器マトリクス UI */\n  .cb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }\n  .cb-card { background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 10px; transition: all 0.3s ease; }\n  .cb-card.closed { border-left: 5px solid #10b981; background: #022c22; }\n  .cb-card.open { border-left: 5px solid #ef4444; background: #450a0a; animation: pulse 1s infinite alternate; }\n  .cb-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }\n  .cb-id { font-size: 13px; font-weight: bold; color: #f8fafc; }\n  .cb-tag { font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 4px; }\n  .cb-tag.closed { background: #166534; color: #4ade80; }\n  .cb-tag.open { background: #991b1b; color: #fca5a5; }\n  .cb-desc { font-size: 11px; color: #94a3b8; }\n  \n  .status-box { padding: 10px 12px; border-radius: 6px; margin-bottom: 8px; transition: all 0.3s ease; }\n  .status-box.on { background: #064e3b; border-left: 5px solid #10b981; color: #a7f3d0; }\n  .status-box.off { background: #7f1d1d; border-left: 5px solid #ef4444; color: #fecaca; animation: pulse 1s infinite alternate; }\n  .status-box.survival { background: #7c2d12; border-left: 5px solid #f97316; color: #ffedd5; animation: pulse-warn 0.8s infinite alternate; }\n  @keyframes pulse { 0% { box-shadow: 0 0 5px rgba(239,68,68,0.4); } 100% { box-shadow: 0 0 15px rgba(239,68,68,0.8); } }\n  @keyframes pulse-warn { 0% { box-shadow: 0 0 5px rgba(249,115,22,0.4); } 100% { box-shadow: 0 0 15px rgba(249,115,22,0.9); } }\n  \n  .label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }\n  .value { font-size: 15px; font-weight: bold; margin-top: 2px; }\n  \n  .battery-bar-container { background: #0f172a; border-radius: 4px; height: 10px; margin-top: 6px; border: 1px solid #334155; overflow: hidden; padding: 1px; }\n  .battery-bar-fill { height: 100%; border-radius: 3px; width: 100%; background: #10b981; transition: width 0.3s ease, background-color 0.3s ease; }\n  \n  .control-btn-group { display: flex; gap: 8px; margin-top: auto; flex-shrink: 0; padding-top: 8px; }\n  .btn-control { flex: 1; border: none; padding: 10px 8px; border-radius: 6px; font-size: 11px; font-weight: bold; cursor: pointer; transition: 0.2s; }\n  .btn-trip { background: #dc2626; color: white; }\n  .btn-trip:hover { background: #b91c1c; box-shadow: 0 0 10px rgba(239,68,68,0.5); }\n  .btn-reset { background: #2563eb; color: white; }\n  .btn-reset:hover { background: #1d4ed8; box-shadow: 0 0 10px rgba(37,99,235,0.5); }\n  \n  .btn-clear { background: #334155; color: #94a3b8; border: 1px solid #475569; padding: 4px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; transition: 0.2s; }\n  .btn-clear:hover { background: #475569; color: #f8fafc; }\n  .terminal { background: #020617; font-family: 'Consolas', 'Courier New', monospace; font-size: 11px; padding: 12px; border-radius: 8px; flex-grow: 1; height: 420px; max-height: 440px; overflow-y: auto; color: #38bdf8; line-height: 1.5; border: 1px solid #0f172a; box-sizing: border-box; }\n  .log-line { margin: 2px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .log-alert { color: #f87171; font-weight: bold; }\n  .log-goose { color: #4ade80; }\n  .log-survival { color: #fbbf24; font-weight: bold; }\n</style>\n</head>\n<body>\n<header>\n  <h1>⚡ 広域電力網 (Kyiv-Grid) 全拠点統合リアルタイム監視コックピット</h1>\n  <span class=\"badge\" id=\"mainBadge\">● ALL STATIONS ONLINE (WAN 50ms)</span>\n</header>\n<div class=\"container\">\n  <div class=\"panel\">\n    <div class=\"panel-title\">🎛️ 変電所遮断器 (Circuit Breakers) 総合可視化ステータス</div>\n    \n    <div class=\"sub-section-title\">⚡ 遮断器マトリクス (CB-101 ~ CB-104) リアルタイム監視</div>\n    <div class=\"cb-grid\">\n      <div class=\"cb-card closed\" id=\"cbCard101\">\n        <div class=\"cb-header\">\n          <span class=\"cb-id\">CB-101</span>\n          <span class=\"cb-tag closed\" id=\"cbTag101\">CLOSED</span>\n        </div>\n        <div class=\"cb-desc\">変電所A: 330kV 基幹送電ライン</div>\n      </div>\n      <div class=\"cb-card closed\" id=\"cbCard102\">\n        <div class=\"cb-header\">\n          <span class=\"cb-id\">CB-102</span>\n          <span class=\"cb-tag closed\" id=\"cbTag102\">CLOSED</span>\n        </div>\n        <div class=\"cb-desc\">変電所A: 110kV 配電サブステーション</div>\n      </div>\n      <div class=\"cb-card closed\" id=\"cbCard103\">\n        <div class=\"cb-header\">\n          <span class=\"cb-id\">CB-103</span>\n          <span class=\"cb-tag closed\" id=\"cbTag103\">CLOSED</span>\n        </div>\n        <div class=\"cb-desc\">変電所B: 産業用メイン受電盤</div>\n      </div>\n      <div class=\"cb-card closed\" id=\"cbCard104\">\n        <div class=\"cb-header\">\n          <span class=\"cb-id\">CB-104</span>\n          <span class=\"cb-tag closed\" id=\"cbTag104\">CLOSED</span>\n        </div>\n        <div class=\"cb-desc\">変電所B: 非常用バックアップライン</div>\n      </div>\n    </div>\n    \n    <div class=\"sub-section-title\">🛡️ IEC 61850 GOOSE & DNP3 制御連携</div>\n    <div class=\"status-box on\" id=\"iedBox\">\n      <div class=\"label\">保護リレー IED_01 / IED_02 インターロック</div>\n      <div class=\"value\" id=\"iedVal\">GOOSE MULTICAST NORMAL (0x88B8)</div>\n    </div>\n    \n    <div class=\"status-box on\" id=\"upsBox\" style=\"background:#1e293b; border-left:5px solid #3b82f6; color:#93c5fd;\">\n      <div class=\"label\">仮想UPS バッテリー残量 (RFC 1628 SOC)</div>\n      <div class=\"value\" id=\"upsVal\">100.0% (Line Power)</div>\n      <div class=\"battery-bar-container\">\n        <div class=\"battery-bar-fill\" id=\"upsBar\"></div>\n      </div>\n    </div>\n    \n    <div class=\"control-btn-group\">\n      <button class=\"btn-control btn-trip\" onclick=\"triggerTrip()\">⚠️ [攻撃実験] 遮断器 一斉開放 (All Trip)</button>\n      <button class=\"btn-control btn-reset\" onclick=\"triggerReset()\">🔄 [復旧操作] 遮断器 一斉再投入 (All Reset)</button>\n    </div>\n  </div>\n  <div class=\"panel\">\n    <div class=\"panel-title\">\n      <span>📡 広域パケット & L2 GOOSE ライブストリーム</span>\n      <button class=\"btn-clear\" onclick=\"clearLogs()\">🧹 ログ消去</button>\n    </div>\n    <div class=\"terminal\" id=\"term\">\n      <div class=\"log-line\">[INFO] Starting Kyiv-Grid Wide-Area Live Stream...</div>\n      <div class=\"log-line\">[WAN] SCADA (10.0.10.10) -> Sub_A (10.0.20.10) RTT=50.2ms [OK]</div>\n      <div class=\"log-line\">[WAN] SCADA (10.0.10.10) -> Sub_B (10.0.30.10) RTT=50.1ms [OK]</div>\n    </div>\n  </div>\n</div>\n<script>\nlet cbStates = { CB101: true, CB102: true, CB103: true, CB104: true };\nlet upsSoc = 100.0;\nlet timer = null;\nconst MAX_LOGS = 20;\n\nfunction updateCbUI(id, isClosed) {\n  const card = document.getElementById('cbCard' + id);\n  const tag = document.getElementById('cbTag' + id);\n  if (isClosed) {\n    card.className = 'cb-card closed';\n    tag.className = 'cb-tag closed';\n    tag.textContent = 'CLOSED';\n  } else {\n    card.className = 'cb-card open';\n    tag.className = 'cb-tag open';\n    tag.textContent = 'TRIPPED';\n  }\n}\n\nfunction updateUpsBar(soc) {\n  const bar = document.getElementById('upsBar');\n  bar.style.width = soc + '%';\n  if (soc > 60) {\n    bar.style.background = '#10b981';\n  } else if (soc > 30) {\n    bar.style.background = '#f59e0b';\n  } else {\n    bar.style.background = '#ef4444';\n  }\n}\n\nfunction appendLog(text, isAlert=false, isGoose=false, isSurvival=false) {\n  const term = document.getElementById('term');\n  const div = document.createElement('div');\n  div.className = 'log-line' + (isAlert ? ' log-alert' : '') + (isGoose ? ' log-goose' : '') + (isSurvival ? ' log-survival' : '');\n  div.textContent = `[${new Date().toISOString().substring(11,23)}] ${text}`;\n  term.appendChild(div);\n  while (term.children.length > MAX_LOGS) { term.removeChild(term.firstChild); }\n  term.scrollTop = term.scrollHeight;\n}\n\nfunction clearLogs() {\n  document.getElementById('term').innerHTML = '<div class=\"log-line\">[INFO] Log cleared by user. Resuming stream...</div>';\n}\n\nsetInterval(() => {\n  const allClosed = Object.values(cbStates).every(v => v);\n  if (allClosed) {\n    appendLog('[GOOSE] Sub_A: 01:0c:cd:01:00:01 -> IED_02 (EtherType 0x88B8) StNum=142 SqNum=1', false, true);\n  }\n}, 2000);\n\nfunction triggerTrip() {\n  cbStates = { CB101: false, CB102: false, CB103: false, CB104: false };\n  ['101', '102', '103', '104'].forEach(id => updateCbUI(id, false));\n  \n  document.getElementById('mainBadge').className = 'badge alert';\n  document.getElementById('mainBadge').textContent = '⚠️ GRID BLACKOUT / ALL BREAKERS TRIPPED';\n  document.getElementById('iedVal').textContent = 'GOOSE ALARM / INTERLOCK TRIP';\n  document.getElementById('iedBox').className = 'status-box off';\n  \n  appendLog('[CONTROL] Emergency ALL Breakers Trip Initiated! (DNP3/IEC104 Attack Payload)', true);\n  appendLog('[ALERT] CB-101, CB-102, CB-103, CB-104 ALL TRIPPED! Substation A/B Power Lost!', true);\n  appendLog('[GOOSE] Sub_A Protection Interlock Fired! StNum=143 SqNum=2', true);\n  appendLog('[SNMP] Trap Fired -> OID .1.3.6.1.2.1.33.1.2.4 (UPS On Battery)', true);\n  \n  fetch('/api/breaker', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({state: false, cb_states: cbStates, soc: upsSoc}) }).catch(e=>{});\n  \n  if (timer) clearInterval(timer);\n  timer = setInterval(() => {\n    if (upsSoc > 62.0) {\n      upsSoc = +(upsSoc - (Math.random() * 0.7 + 0.4)).toFixed(1);\n      document.getElementById('upsVal').textContent = upsSoc + '% (Battery Discharge)';\n      document.getElementById('upsBox').className = 'status-box off';\n      updateUpsBar(upsSoc);\n      appendLog(`[UPS] Battery Discharging smoothly: SOC ${upsSoc}%`, true);\n    } else {\n      upsSoc = +(62.0 + (Math.random() * 8.5)).toFixed(1);\n      document.getElementById('upsVal').textContent = upsSoc + '% (GENSET & RESERVE SURVIVAL POOL)';\n      document.getElementById('upsBox').className = 'status-box survival';\n      updateUpsBar(upsSoc);\n      appendLog(`[UPS] Genset Backup Sync! Surviving resiliently at SOC ${upsSoc}%`, false, false, true);\n    }\n    fetch('/api/breaker', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({state: false, cb_states: cbStates, soc: upsSoc}) }).catch(e=>{});\n  }, 1000);\n}\n\nfunction triggerReset() {\n  cbStates = { CB101: true, CB102: true, CB103: true, CB104: true };\n  ['101', '102', '103', '104'].forEach(id => updateCbUI(id, true));\n  \n  upsSoc = 100.0;\n  if (timer) clearInterval(timer);\n  document.getElementById('mainBadge').className = 'badge';\n  document.getElementById('mainBadge').textContent = '● ALL STATIONS ONLINE (WAN 50ms)';\n  document.getElementById('iedVal').textContent = 'GOOSE MULTICAST NORMAL (0x88B8)';\n  document.getElementById('iedBox').className = 'status-box on';\n  document.getElementById('upsVal').textContent = '100.0% (Line Power)';\n  document.getElementById('upsBox').className = 'status-box on';\n  document.getElementById('upsBox').style = \"background:#1e293b; border-left:5px solid #3b82f6; color:#93c5fd;\";\n  updateUpsBar(100.0);\n  appendLog('[CONTROL] All Circuit Breakers Reset & Closed. Line Power Restored.', false, true);\n  fetch('/api/breaker', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({state: true, cb_states: cbStates, soc: 100.0}) }).catch(e=>{});\n}\n\nupdateUpsBar(100.0);\n\nfetch('/api/status').then(r=>r.json()).then(d=>{\n  if(d.is_tripped){\n    cbStates={CB101:false,CB102:false,CB103:false,CB104:false};\n    if(d.cb_states){cbStates=d.cb_states;}\n    Object.keys(cbStates).forEach(k=>{updateCbUI(k.replace('CB',''),cbStates[k]);});\n    document.getElementById('mainBadge').className='badge alert';\n    document.getElementById('mainBadge').textContent='\\u26a0\\ufe0f GRID BLACKOUT / ALL BREAKERS TRIPPED';\n    document.getElementById('iedVal').textContent='GOOSE ALARM / INTERLOCK TRIP';\n    document.getElementById('iedBox').className='status-box off';\n    if(d.ups_soc!==undefined){\n      upsSoc=d.ups_soc;\n      document.getElementById('upsVal').textContent=upsSoc+'% (Battery Discharge)';\n      document.getElementById('upsBox').className='status-box off';\n      updateUpsBar(upsSoc);\n    }\n    appendLog('[SYNC] Server state loaded: GRID TRIPPED',true);\n  }\n}).catch(e=>{});\n</script>\n</body>\n</html>\n",
