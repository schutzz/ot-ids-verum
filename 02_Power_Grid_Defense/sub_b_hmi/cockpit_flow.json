    {
        "id": "http_in_cockpit",
        "type": "http in",
        "z": "tab_cockpit",
        "name": "GET /cockpit",
        "url": "/cockpit",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 120,
        "y": 80,
        "wires": [
            [
                "template_cockpit_html"
            ]
