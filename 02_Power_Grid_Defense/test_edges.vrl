  src_ip = to_string(.tags."network_src_ip") ?? "unknown"
  dest_ip = to_string(.tags."network_dest_ip") ?? "unknown"
  if src_ip == "" || src_ip == "unknown" || dest_ip == "" || dest_ip == "unknown" { abort }
  
  edge_id = src_ip + "-" + dest_ip
  
  fc_code = to_string(.fc) ?? "Unknown"
  main_stat = "DNP3 FC: " + fc_code
  edge_thickness = 3
  
  . = {
    "@timestamp": ."@timestamp",
    "id": edge_id,
    "source": src_ip,
    "target": dest_ip,
    "mainStat": main_stat,
    "color": .color,
    "thickness": edge_thickness
  }
