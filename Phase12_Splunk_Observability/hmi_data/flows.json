    {
        "id": "widget_gate_switch",
        "type": "ui_template",
        "z": "f6f2187d.f17ca8",
        "group": "grp_main",
        "name": "\u9580\u6249 \u5927\u30a2\u30a4\u30b3\u30f3",
        "order": 3,
        "width": "5",
        "height": "4",
        "format": "<div style=\"display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; cursor:pointer; user-select:none;\"\n     ng-click=\"send({payload: msg.payload === 'OPEN' ? 'CLOSED' : 'OPEN'})\">\n    <div style=\"font-size:72px; line-height:1; margin-bottom:10px; transition: transform 0.2s;\"\n         onmousedown=\"this.style.transform='scale(0.9)'\"\n         onmouseup=\"this.style.transform='scale(1)'\"\n         onmouseleave=\"this.style.transform='scale(1)'\">\n        <span ng-if=\"msg.payload === 'OPEN'\">\ud83d\udd13</span>\n        <span ng-if=\"msg.payload !== 'OPEN'\">\ud83d\udd12</span>\n    </div>\n    <div style=\"font-size:16px; font-weight:bold;\" ng-style=\"{color: msg.payload === 'OPEN' ? '#ff9800' : '#4caf50'}\">\n        {{msg.payload === 'OPEN' ? '\u958b\u653e\u4e2d (OPEN)' : '\u65bd\u9320\u4e2d (CLOSED)'}}\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 510,
        "y": 240,
        "wires": [
            [
                "gate_control_func"
            ]
        ]
    },
    {
        "id": "gate_control_func",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Gate Control",
        "func": "const fetch = global.get('fetch');\nconst trace_id = Math.random().toString(16).substring(2, 18) + Math.random().toString(16).substring(2, 18);\nconst span_id = Math.random().toString(16).substring(2, 18);\nconst timestamp_us = Math.floor(Date.now() * 1000);\n\nconst span = [{\n    traceId: trace_id,\n    id: span_id,\n    name: \"gate_toggle\",\n    kind: \"SERVER\",\n    timestamp: timestamp_us,\n    duration: 1000,\n    localEndpoint: { serviceName: \"hmi-nodered\" },\n    tags: {\n        \"gate_state\": msg.payload,\n        \"message\": \"Operator toggled gate\"\n    }\n}];\n\nconst api_payload = JSON.stringify({\n    trace_id: trace_id,\n    span_id: span_id,\n    \"event.name\": \"gate_toggle\"\n});\n\ntry {\n    fetch('http://192.168.151.40:9411/api/v2/spans', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: JSON.stringify(span)\n    }).catch(e => { node.warn(\"Fetch spans failed: \" + e.message); });\n    \n    fetch('http://192.168.151.30:5000/', {\n        method: 'POST',\n        headers: {'Content-Type': 'application/json'},\n        body: api_payload\n    }).catch(e => { node.warn(\"Fetch api failed: \" + e.message); });\n    node.warn(\"Sent trace for gate_toggle\");\n} catch(e) {\n    node.warn(\"Synchronous fetch error: \" + e.message);\n}\n\nflow.set('gateState', msg.payload);\nreturn null;",
        "outputs": 1,
        "x": 710,
        "y": 240,
        "wires": [
            [
                "widget_gate_switch"
            ]
        ]
    },
    {
        "id": "widget_camera",
        "type": "ui_template",
        "z": "f6f2187d.f17ca8",
        "group": "grp_main",
        "name": "Live Camera",
        "order": 4,
        "width": "16",
        "height": "10",
        "format": "<style>\n.cw{width:100%;height:100%;background:#0a0a0a;border-radius:6px;overflow:hidden;border:2px solid #c00;box-shadow:0 0 15px rgba(200,0,0,.3); display:flex; flex-direction:column; margin-top:5px;}\n.ch{background:linear-gradient(90deg,#8b0000,#c00);color:#fff;padding:4px 8px;font:bold 11px 'Courier New',monospace;display:flex;justify-content:space-between; flex-shrink: 0;}\n.ch .b{animation:bl 1s infinite}@keyframes bl{50%{opacity:.2}}\n.cv{width:100%;flex-grow:1;background:#000}\n.cv iframe{width:100%;height:100%;border:none;pointer-events:none;}\n.cf{background:#111;color:#0f0;padding:2px 8px;font:9px 'Courier New',monospace;display:flex;justify-content:space-between; flex-shrink: 0;}\n</style>\n<div class=\"cw\">\n<div class=\"ch\"><span><span class=\"b\">\u25cf REC</span> CAM01</span><span id=\"ct\"></span></div>\n<div class=\"cv\"><iframe src=\"http://localhost:8888/cam1/\" allow=\"autoplay\"></iframe></div>\n<div class=\"cf\"><span>OT-LAB ISOLATED</span><span>HLS/H.264</span></div>\n</div>\n<script>setInterval(function(){document.getElementById('ct').textContent=new Date().toLocaleString('ja-JP')},1000)</script>",
        "storeOutMessages": true,
