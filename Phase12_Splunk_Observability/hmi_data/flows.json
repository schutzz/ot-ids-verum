    {
        "id": "kill_switch_func",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Get Attacker IP",
        "func": "var alert = flow.get('last_alert');\nif (alert && alert.attacker_ip) {\n    const fetch = global.get('fetch');\n    const trace_id = Math.random().toString(16).substring(2, 18) + Math.random().toString(16).substring(2, 18);\n    const span_id = Math.random().toString(16).substring(2, 18);\n    const timestamp_us = Math.floor(Date.now() * 1000);\n    \n    const span = [{\n        traceId: trace_id,\n        id: span_id,\n        name: \"isolate_attacker\",\n        kind: \"SERVER\",\n        timestamp: timestamp_us,\n        duration: 1000,\n        localEndpoint: { serviceName: \"hmi-nodered\" },\n        tags: {\n            \"attacker_ip\": alert.attacker_ip,\n            \"message\": \"Operator initiated emergency isolation\"\n        }\n    }];\n    \n    const api_payload = JSON.stringify({\n        trace_id: trace_id,\n        span_id: span_id,\n        \"event.name\": \"isolate_attacker\"\n    });\n    \n    try {\n        fetch('http://192.168.151.40:9411/api/v2/spans', {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: JSON.stringify(span)\n        }).catch(e => {});\n        \n        fetch('http://192.168.151.30:5000/', {\n            method: 'POST',\n            headers: {'Content-Type': 'application/json'},\n            body: api_payload\n        }).catch(e => {});\n    } catch(e) {}\n    \n    msg.payload = alert.attacker_ip;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "x": 360,
        "y": 640,
        "wires": [
            [
                "kill_switch_exec",
                "kill_switch_clear_ui"
            ]
        ]
    },
    {
        "id": "kill_switch_clear_ui",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Clear Alert",
        "func": "flow.set('last_alert', null);\nmsg.payload = null;\nreturn msg;",
        "outputs": 1,
        "x": 550,
        "y": 680,
        "wires": [
            [
                "ids_alert_ui"
            ]
        ]
    },
