        "order": 0,
        "width": "16",
        "height": "3",
        "format": "<div ng-if=\"msg.payload\" style=\"background-color:#cc0000; color:white; padding:15px; font-weight:bold; border-radius:8px; text-align:center; animation: blink 1s linear infinite; border: 3px solid #ff4444; box-shadow: 0 0 20px #ff0000;\">\n  <style>@keyframes blink { 50% { opacity: 0.5; } }</style>\n  <span style=\"font-size:24px;\">\ud83d\udea8 SECURITY ALERT (L2 ANOMALY) \ud83d\udea8</span><br><br>\n  <span style=\"font-size:18px;\">Type: {{msg.payload.alert_type}}</span><br>\n  Attacker IP: {{msg.payload.attacker_ip}} | MAC: {{msg.payload.attacker_mac}}<br>\n  {{msg.payload.details}}\n</div>",
